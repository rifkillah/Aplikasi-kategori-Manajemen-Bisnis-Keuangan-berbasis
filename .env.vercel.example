# Salin nilai-nilai ini ke Vercel → Project → Settings → Environment Variables.
# Jangan commit file .env asli. File ini hanya contoh.

APP_NAME=Kasirin
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://nama-project.vercel.app

LOG_CHANNEL=stderr

# --- Database eksternal (wajib; Vercel tidak menyediakan MySQL/Postgres sendiri) ---
# Neon/Vercel Postgres menyuntikkan DATABASE_URL otomatis. Aplikasi sudah membacanya.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Contoh Neon Postgres (integrasi gratis di Vercel Marketplace):
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Alternatif: satu URL koneksi (bisa dipakai untuk MySQL maupun Postgres)
# DB_URL=postgresql://user:password@host/db?sslmode=require

# --- Session, cache, queue ---
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Storage ---
# File upload (logo bisnis) bersifat sementara di container Vercel.
# Untuk permanen, gunakan Vercel Blob / S3 dan set FILESYSTEM_DISK=s3.
FILESYSTEM_DISK=local

MAIL_MAILER=log
